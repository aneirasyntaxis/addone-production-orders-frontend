<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DESARROLLO: Deshabilitar validación SSL -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    
    <!-- Permitir TODO el tráfico y confiar en todos los certificados -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>