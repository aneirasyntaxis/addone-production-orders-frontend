{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://addone.syntaxis.cl/api"
      },
      "prebuildCommand": "bash eas-build-pre-install.sh"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://addone.syntaxis.cl/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
